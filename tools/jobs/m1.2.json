{"path":"/","name":"qa-f4-search","width":1280,"theme":"light","shot":true,"viewport":true,"action":"document.querySelector('[data-search]').click();await new Promise(r=>setTimeout(r,300));const i=document.querySelector('[data-palette] input');Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,\"shiv\");i.dispatchEvent(new Event('input',{bubbles:true}));await new Promise(r=>setTimeout(r,900));","expect":"const t=document.querySelector('[data-palette]')?.innerText??'';return (t.includes('Shiv Nagar CC Road')&&t.includes('Shiv Saini'))||t.slice(0,300);"},

# Copy this file to functions/.env (that file is never committed) and fill it in before `firebase deploy`.
# See DEPLOY.md, "Deploy the rules, indexes and functions".

# The Google email address of the FIRST OWNER (you). Only this address can run "Set up as the first owner", only
# once, and only when its email is verified (Google sign-in always is). Use a full address like you@gmail.com.
OWNER_EMAIL=

# Everything else (App Check enforce switch, email key, push key, website key) is set later, from the app:
# Settings > Setup & integrations. Nothing secret ever goes in this file.

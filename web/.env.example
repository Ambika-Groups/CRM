# Copy this file to web/.env.local to run the CRM on your own computer, and put the SAME names and values in
# Netlify > Site configuration > Environment variables for the live site. web/.env.local is never committed.
# These are public web settings (they are in every page the app sends), so they are not secrets. Real secrets
# (email key, website key) are never put here: you enter them in the app, under Settings > Setup & integrations.
#
# Leave all of these empty and the app runs in DEMO mode with sample data. Once any one is set, demo mode is off.
#
# You can also skip this file and paste the Firebase config on the Setup page (Settings > Setup & integrations),
# which keeps it on that device only. Netlify's variables are the way to give every device the same connection.

# Firebase console > Project settings (the gear) > General > Your apps > the web app > SDK setup and configuration.
# The same six values are in the "firebaseConfig" block shown there.

# firebaseConfig.apiKey  (starts with AIza)
NEXT_PUBLIC_FIREBASE_API_KEY=

# firebaseConfig.authDomain. Best: your own site address without https://, like crm.yourcompany.in, so Google sign-in
# stays on your domain (the app forwards /__/auth to Firebase for you). Otherwise: your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# firebaseConfig.projectId  (for example ambika-crm)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# firebaseConfig.storageBucket  (ends with .firebasestorage.app or .appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# firebaseConfig.messagingSenderId  (digits only)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# firebaseConfig.appId  (looks like 1:123456789012:web:abc123def456)
NEXT_PUBLIC_FIREBASE_APP_ID=

# OPTIONAL. App Check's reCAPTCHA v3 site key (D-41). Google reCAPTCHA admin (google.com/recaptcha/admin) > create a site of
# type "reCAPTCHA v3" > copy the Site key (40 characters, starts with 6L). Also register the web app in Firebase console >
# App Check. You can set the key in the app (Setup & integrations) and then copy the line it shows here.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
